<project name="Mujina-Public" default="dist" basedir=".">
  <description>
    Mujina-Public build file.
  </description>
  <!-- set global properties for this build -->
  <property name="src" location="src"/>
  <property name="build" location="build"/>
  <property name="compile" location="compile"/>
  <property name="libs" location="libs"/>

  <target name="init">
    <!-- Create the time stamp -->
    <tstamp/>
    <!-- Create the build directory structure used by compile -->
    <mkdir dir="${build}"/>
    <mkdir dir="${compile}"/>
  </target>

  <path id="classpath">
    <fileset dir="libs/1.21.8" includes="minecraft-1.21.8-deobf.jar"/>
    <fileset dir="libs" includes="asm-9.6.jar"/>
  </path>

  <target name="compile" depends="init"
        description="Compile the source">
    <!-- Compile the Java code from ${src} into ${compile} -->
    <javac srcdir="${src}" destdir="${compile}" source="21" target="21" fork="true" executable="C:\Program Files\Java\jdk-21\bin\javac.exe" classpathref="classpath">
    </javac>
  </target>

  <target name="dist" depends="compile"
        description="Generate the distribution">
    <!-- Create the libs directory -->
    <mkdir dir="${build}/libs"/>

    <!-- Put everything in ${build} into the InjectableJar.jar file -->
    <jar destfile="${build}/libs/InjectableJar.jar" basedir="${compile}">
<!-- <zipgroupfileset dir="${libs}" includes="asm-9.6.jar"/> -->
    </jar>
  </target>

  <target name="clean"
        description="Clean up">
    <!-- Delete the ${compile} directory -->
    <delete dir="${compile}"/>
  </target>

</project>